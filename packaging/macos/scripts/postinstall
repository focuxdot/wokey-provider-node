#!/bin/sh
set -eu

LABEL="ai.wokey.provider-node"
PLIST="${PROVIDER_NODE_PLIST:-/Library/LaunchAgents/${LABEL}.plist}"
INSTALL_DIR="${PROVIDER_NODE_INSTALL_DIR:-/usr/local/wokey-provider-node}"
BIN="${INSTALL_DIR}/bin/provider-node"
CONSOLE_URL="http://127.0.0.1:16888/"
CONSOLE_USER="${PROVIDER_NODE_CONSOLE_USER:-$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)}"
SEED_DIR="${INSTALL_DIR}/seed/runtime"
VERSION="$(/bin/cat "${INSTALL_DIR}/seed/VERSION" 2>/dev/null || true)"

case "${VERSION}" in
  ''|*[!0-9A-Za-z.-]*)
    echo "Invalid Provider Node runtime seed version: ${VERSION}" >&2
    exit 1
    ;;
esac
if [ ! -f "${SEED_DIR}/package.json" ] || [ ! -f "${SEED_DIR}/dist/provider-node/server.js" ]; then
  echo "Provider Node runtime seed is incomplete." >&2
  exit 1
fi

wait_for_console() {
  attempt=0
  while [ "${attempt}" -lt 120 ]; do
    if /usr/bin/curl -fsS "${CONSOLE_URL}api/status" >/dev/null 2>&1; then
      return 0
    fi
    attempt=$((attempt + 1))
    /bin/sleep 0.5
  done
  return 1
}

open_console_for_user() {
  if [ -z "${CONSOLE_UID:-}" ] || [ -z "${CONSOLE_USER:-}" ]; then
    return 0
  fi
  /bin/launchctl asuser "${CONSOLE_UID}" /usr/bin/sudo -u "${CONSOLE_USER}" /usr/bin/open "${CONSOLE_URL}" >/dev/null 2>&1 || true
}

node_is_supported_for_user() {
  candidate="$1"
  [ -f "${candidate}" ] && [ -x "${candidate}" ] || return 1
  if [ "$(/usr/bin/id -u)" = "${CONSOLE_UID}" ]; then
    "${candidate}" -e 'const [a,b,c]=process.versions.node.split(".").map(Number); process.exit(a>22 || (a===22 && (b>22 || (b===22 && c>=2))) ? 0 : 1)' >/dev/null 2>&1
  else
    /bin/launchctl asuser "${CONSOLE_UID}" /usr/bin/sudo -u "${CONSOLE_USER}" \
      "${candidate}" -e 'const [a,b,c]=process.versions.node.split(".").map(Number); process.exit(a>22 || (a===22 && (b>22 || (b===22 && c>=2))) ? 0 : 1)' >/dev/null 2>&1
  fi
}

find_user_node() {
  for candidate in \
    "${DATA_DIR}/node-path" \
    "/opt/homebrew/bin/node" \
    "/usr/local/bin/node" \
    "/usr/bin/node" \
    "${USER_HOME}/.volta/bin/node" \
    "${USER_HOME}/.local/share/fnm/aliases/default/bin/node" \
    "${USER_HOME}/Library/Application Support/fnm/aliases/default/bin/node"
  do
    if [ "${candidate}" = "${DATA_DIR}/node-path" ]; then
      candidate="$(/bin/cat "${candidate}" 2>/dev/null || true)"
    fi
    if node_is_supported_for_user "${candidate}"; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done

  for versions_dir in \
    "${USER_HOME}/.nvm/versions/node" \
    "${USER_HOME}/.local/share/fnm/node-versions" \
    "${USER_HOME}/Library/Application Support/fnm/node-versions" \
    "${USER_HOME}/.volta/tools/image/node"
  do
    [ -d "${versions_dir}" ] || continue
    candidates="$(/usr/bin/find "${versions_dir}" \( -type f -o -type l \) -path '*/bin/node' -perm -111 -print 2>/dev/null || true)"
    previous_ifs="${IFS}"
    IFS='
'
    for candidate in ${candidates}; do
      if node_is_supported_for_user "${candidate}"; then
        IFS="${previous_ifs}"
        printf '%s\n' "${candidate}"
        return 0
      fi
    done
    IFS="${previous_ifs}"
  done
  return 1
}

persist_user_node_hint() {
  node_bin="$(find_user_node || true)"
  [ -n "${node_bin}" ] || return 0
  temporary_hint="$(/usr/bin/mktemp "${DATA_DIR}/.node-path.XXXXXX")"
  (umask 077; printf '%s\n' "${node_bin}" > "${temporary_hint}")
  /usr/sbin/chown "${CONSOLE_USER}:staff" "${temporary_hint}" >/dev/null 2>&1 || true
  /bin/chmod 600 "${temporary_hint}" || true
  /bin/mv -f "${temporary_hint}" "${DATA_DIR}/node-path"
}

/bin/chmod 755 "${BIN}" || true
/bin/chmod 644 "${PLIST}" || true

if [ -n "${CONSOLE_USER}" ] && [ "${CONSOLE_USER}" != "root" ]; then
  CONSOLE_UID="$(/usr/bin/id -u "${CONSOLE_USER}" 2>/dev/null || true)"
  USER_HOME="${PROVIDER_NODE_USER_HOME:-$(/usr/bin/dscl . -read "/Users/${CONSOLE_USER}" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}' || true)}"

  if [ -n "${USER_HOME}" ]; then
    DATA_DIR="${USER_HOME}/Library/Application Support/Wokey Provider Node"
    RUNTIME_ROOT="${DATA_DIR}/runtime"
    VERSIONS_DIR="${RUNTIME_ROOT}/versions"
    TARGET_DIR="${VERSIONS_DIR}/${VERSION}"
    CURRENT_LINK="${RUNTIME_ROOT}/current"
    PREVIOUS_TARGET="$(/bin/readlink "${CURRENT_LINK}" 2>/dev/null || true)"
    /bin/mkdir -p "${DATA_DIR}" "${VERSIONS_DIR}"
    /usr/sbin/chown "${CONSOLE_USER}:staff" "${DATA_DIR}" >/dev/null 2>&1 || true
    /bin/chmod 700 "${DATA_DIR}" || true
    persist_user_node_hint
    if [ ! -f "${TARGET_DIR}/package.json" ]; then
      STAGING_DIR="${VERSIONS_DIR}/.${VERSION}.installing.$$"
      /bin/rm -rf "${STAGING_DIR}"
      /usr/bin/ditto --norsrc "${SEED_DIR}" "${STAGING_DIR}"
      /bin/mv "${STAGING_DIR}" "${TARGET_DIR}"
    fi
    TEMP_LINK="${RUNTIME_ROOT}/.current-installing.$$"
    /bin/rm -f "${TEMP_LINK}"
    /bin/ln -s "versions/${VERSION}" "${TEMP_LINK}"
    /bin/mv -fh "${TEMP_LINK}" "${CURRENT_LINK}"
    /usr/sbin/chown -R "${CONSOLE_USER}:staff" "${RUNTIME_ROOT}" || true
    /bin/chmod 700 "${RUNTIME_ROOT}" "${VERSIONS_DIR}" || true
  fi

  if [ -n "${CONSOLE_UID}" ] && [ "${PROVIDER_NODE_SKIP_SERVICE_CONTROL:-0}" != "1" ]; then
    /bin/launchctl bootout "gui/${CONSOLE_UID}" "${PLIST}" >/dev/null 2>&1 || true
    /bin/launchctl bootstrap "gui/${CONSOLE_UID}" "${PLIST}" >/dev/null 2>&1 || true
    /bin/launchctl enable "gui/${CONSOLE_UID}/${LABEL}" >/dev/null 2>&1 || true
    /bin/launchctl kickstart -k "gui/${CONSOLE_UID}/${LABEL}" >/dev/null 2>&1 || true
    if wait_for_console; then
      open_console_for_user
    else
      /bin/launchctl bootout "gui/${CONSOLE_UID}" "${PLIST}" >/dev/null 2>&1 || true
      if [ -n "${PREVIOUS_TARGET:-}" ] \
        && [ -f "${RUNTIME_ROOT}/${PREVIOUS_TARGET}/package.json" ] \
        && [ -f "${RUNTIME_ROOT}/${PREVIOUS_TARGET}/dist/provider-node/server.js" ]; then
        TEMP_LINK="${RUNTIME_ROOT}/.current-rollback.$$"
        /bin/ln -s "${PREVIOUS_TARGET}" "${TEMP_LINK}"
        /bin/mv -fh "${TEMP_LINK}" "${CURRENT_LINK}"
      else
        /bin/rm -f "${CURRENT_LINK}"
      fi
      /bin/launchctl bootstrap "gui/${CONSOLE_UID}" "${PLIST}" >/dev/null 2>&1 || true
      /bin/launchctl kickstart -k "gui/${CONSOLE_UID}/${LABEL}" >/dev/null 2>&1 || true
      echo "Wokey Provider Node ${VERSION} did not become healthy; attempted to restore the previous runtime." >&2
      exit 1
    fi
  fi
fi

exit 0
